# ── Ollama Configuration ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ── ChromaDB / RAG ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Server ───────────────────────────────────────────────────────────
PORT=5000
MAX_UPLOAD_SIZE_MB=50

# ── Rate Limiting ────────────────────────────────────────────────────
# (Limits are applied per IP address)
RATE_LIMIT_PER_MIN=100
