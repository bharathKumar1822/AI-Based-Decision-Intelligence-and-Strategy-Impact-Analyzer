{
  "version": 2,
  "name": "decision-intelligence-project",
  "cleanUrls": true,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-based-decision-intelligence-and-hh6v.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend"
    },
    {
      "source": "/((?!frontend/).*)",
      "destination": "/frontend/$1"
    }
  ]
}

